<PhysiCell_settings version="devel-version">

    <domain>
        <x_min>-300.0</x_min>
        <x_max>300.0</x_max>
        <y_min>-300.0</y_min>
        <y_max>300.0</y_max>
        <z_min>-10.0</z_min>
        <z_max>10.0</z_max>
        <dx>20.0</dx>
        <dy>20.0</dy>
        <dz>20.0</dz>
        <use_2D>true</use_2D>
    </domain>

    <overall>
        <max_time units="min">2880</max_time>
        <time_units>min</time_units>
        <space_units>micron</space_units>
        <dt_diffusion units="min">0.02</dt_diffusion>
        <dt_mechanics units="min">0.1</dt_mechanics>
        <dt_phenotype units="min">1</dt_phenotype>
    </overall>

    <parallel>
        <omp_num_threads>4</omp_num_threads>
    </parallel>

    <save>
        <folder>./output</folder>
        <full_data>
            <interval units="min">30</interval>
            <enable>true</enable>
        </full_data>
        <SVG>
            <interval units="min">30</interval>
            <enable>true</enable>
            <plot_substrate enabled="false" limits="false">
                <substrate>nutrient</substrate>
                <min_conc />
                <max_conc />
                <colormap />
            </plot_substrate>
        </SVG>
        <legacy_data>
            <enable>false</enable>
        </legacy_data>
    </save>

    <options>
        <legacy_random_points_on_sphere_in_divide>false</legacy_random_points_on_sphere_in_divide>
        <virtual_wall_at_domain_edge>true</virtual_wall_at_domain_edge>
        <disable_automated_spring_adhesions>true</disable_automated_spring_adhesions>
        <random_seed>0</random_seed>
    </options>

    <microenvironment_setup>
        <variable name="nutrient" units="dimensionless" ID="0">
            <physical_parameter_set>
                <diffusion_coefficient units="micron^2/min">40000.0</diffusion_coefficient>
                <decay_rate units="1/min">0.001</decay_rate>
            </physical_parameter_set>
            <initial_condition units="dimensionless">0.05</initial_condition>
            <Dirichlet_boundary_condition units="dimensionless" enabled="True">0.05</Dirichlet_boundary_condition>
            <Dirichlet_options>
                <boundary_value ID="xmin" enabled="True">0.05</boundary_value>
                <boundary_value ID="xmax" enabled="True">0.05</boundary_value>
                <boundary_value ID="ymin" enabled="True">0.05</boundary_value>
                <boundary_value ID="ymax" enabled="True">0.05</boundary_value>
                <boundary_value ID="zmin" enabled="False">0</boundary_value>
                <boundary_value ID="zmax" enabled="False">0</boundary_value>
            </Dirichlet_options>
        </variable>
        <variable name="growth_factor" units="dimensionless" ID="1">
            <physical_parameter_set>
                <diffusion_coefficient units="micron^2/min">40000.0</diffusion_coefficient>
                <decay_rate units="1/min">0.01</decay_rate>
            </physical_parameter_set>
            <initial_condition units="dimensionless">0.0</initial_condition>
            <Dirichlet_boundary_condition units="dimensionless" enabled="True">0.0</Dirichlet_boundary_condition>
            <Dirichlet_options>
                <boundary_value ID="xmin" enabled="True">0.0</boundary_value>
                <boundary_value ID="xmax" enabled="True">0.0</boundary_value>
                <boundary_value ID="ymin" enabled="True">0.0</boundary_value>
                <boundary_value ID="ymax" enabled="True">0.0</boundary_value>
                <boundary_value ID="zmin" enabled="False">0</boundary_value>
                <boundary_value ID="zmax" enabled="False">0</boundary_value>
            </Dirichlet_options>
        </variable>
        <variable name="glucose" units="dimensionless" ID="2">
            <physical_parameter_set>
                <diffusion_coefficient units="micron^2/min">40000.0</diffusion_coefficient>
                <decay_rate units="1/min">0.001</decay_rate>
            </physical_parameter_set>
            <initial_condition units="dimensionless">1.0</initial_condition>
            <Dirichlet_boundary_condition units="dimensionless" enabled="True">1.0</Dirichlet_boundary_condition>
            <Dirichlet_options>
                <boundary_value ID="xmin" enabled="True">1.0</boundary_value>
                <boundary_value ID="xmax" enabled="True">1.0</boundary_value>
                <boundary_value ID="ymin" enabled="True">1.0</boundary_value>
                <boundary_value ID="ymax" enabled="True">1.0</boundary_value>
                <boundary_value ID="zmin" enabled="False">0</boundary_value>
                <boundary_value ID="zmax" enabled="False">0</boundary_value>
            </Dirichlet_options>
        </variable>
        <variable name="oxidative_stress_signal" units="dimensionless" ID="3">
            <physical_parameter_set>
                <diffusion_coefficient units="micron^2/min">40000.0</diffusion_coefficient>
                <decay_rate units="1/min">0.01</decay_rate>
            </physical_parameter_set>
            <initial_condition units="dimensionless">0.0</initial_condition>
            <Dirichlet_boundary_condition units="dimensionless" enabled="True">0.0</Dirichlet_boundary_condition>
            <Dirichlet_options>
                <boundary_value ID="xmin" enabled="True">0.0</boundary_value>
                <boundary_value ID="xmax" enabled="True">0.0</boundary_value>
                <boundary_value ID="ymin" enabled="True">0.0</boundary_value>
                <boundary_value ID="ymax" enabled="True">0.0</boundary_value>
                <boundary_value ID="zmin" enabled="False">0</boundary_value>
                <boundary_value ID="zmax" enabled="False">0</boundary_value>
            </Dirichlet_options>
        </variable>
        <options>
            <calculate_gradients>true</calculate_gradients>
            <track_internalized_substrates_in_each_agent>true</track_internalized_substrates_in_each_agent>
            <initial_condition enabled="false" type="matlab">
                <filename>./config/initial.mat</filename>
            </initial_condition>
            <dirichlet_nodes enabled="false" type="matlab">
                <filename>./config/dirichlet.mat</filename>
            </dirichlet_nodes>
        </options>
    </microenvironment_setup>

    <cell_definitions>
        <cell_definition name="autophagy_cell" ID="0">
            <phenotype>
                <cycle code="2" name="flow cytometry">
                    <phase_transition_rates units="1/min">
                        <rate start_index="0" end_index="1" fixed_duration="false">0.0</rate>
                        <rate start_index="1" end_index="2" fixed_duration="false">0.0</rate>
                        <rate start_index="2" end_index="0" fixed_duration="false">0.0</rate>
                    </phase_transition_rates>
                    <standard_asymmetric_division enabled="False">
                        <asymmetric_division_probability name="autophagy_cell" units="dimensionless">1.0</asymmetric_division_probability>
                    </standard_asymmetric_division>
                </cycle>
                <death>
                    <model code="100" name="apoptosis">
                        <death_rate units="1/min">0</death_rate>
                        <phase_durations units="min">
                            <duration index="0" fixed_duration="true">516</duration>
                        </phase_durations>
                        <parameters>
                            <unlysed_fluid_change_rate units="1/min">0.05</unlysed_fluid_change_rate>
                            <lysed_fluid_change_rate units="1/min">0</lysed_fluid_change_rate>
                            <cytoplasmic_biomass_change_rate units="1/min">1.66667e-02</cytoplasmic_biomass_change_rate>
                            <nuclear_biomass_change_rate units="1/min">5.83333e-03</nuclear_biomass_change_rate>
                            <calcification_rate units="1/min">0</calcification_rate>
                            <relative_rupture_volume units="dimensionless">2.0</relative_rupture_volume>
                        </parameters>
                    </model>
                    <model code="101" name="necrosis">
                        <death_rate units="1/min">0.0</death_rate>
                        <phase_durations units="min">
                            <duration index="0" fixed_duration="true">0</duration>
                            <duration index="1" fixed_duration="true">1440</duration>
                        </phase_durations>
                        <parameters>
                            <unlysed_fluid_change_rate units="1/min">0.05</unlysed_fluid_change_rate>
                            <lysed_fluid_change_rate units="1/min">0</lysed_fluid_change_rate>
                            <cytoplasmic_biomass_change_rate units="1/min">1.66667e-02</cytoplasmic_biomass_change_rate>
                            <nuclear_biomass_change_rate units="1/min">5.83333e-03</nuclear_biomass_change_rate>
                            <calcification_rate units="1/min">0</calcification_rate>
                            <relative_rupture_volume units="dimensionless">2.0</relative_rupture_volume>
                        </parameters>
                    </model>
                </death>
                <volume>
                    <total units="micron^3">1000</total>
                    <fluid_fraction units="dimensionless">0.75</fluid_fraction>
                    <nuclear units="micron^3">540</nuclear>
                    <fluid_change_rate units="1/min">0.05</fluid_change_rate>
                    <cytoplasmic_biomass_change_rate units="1/min">0.0045</cytoplasmic_biomass_change_rate>
                    <nuclear_biomass_change_rate units="1/min">0.0055</nuclear_biomass_change_rate>
                    <calcified_fraction units="dimensionless">0</calcified_fraction>
                    <calcification_rate units="1/min">0</calcification_rate>
                    <relative_rupture_volume units="dimensionless">2.0</relative_rupture_volume>
                </volume>
                <mechanics>
                    <cell_cell_adhesion_strength units="micron/min">0.4</cell_cell_adhesion_strength>
                    <cell_cell_repulsion_strength units="micron/min">10.0</cell_cell_repulsion_strength>
                    <relative_maximum_adhesion_distance units="dimensionless">1.25</relative_maximum_adhesion_distance>
                    <cell_adhesion_affinities>
                        <cell_adhesion_affinity name="autophagy_cell">1.0</cell_adhesion_affinity>
                    </cell_adhesion_affinities>
                    <options>
                        <set_relative_equilibrium_distance enabled="false" units="dimensionless">1.8</set_relative_equilibrium_distance>
                        <set_absolute_equilibrium_distance enabled="false" units="micron">15.12</set_absolute_equilibrium_distance>
                    </options>
                    <attachment_elastic_constant units="1/min">0.01</attachment_elastic_constant>
                    <attachment_rate units="1/min">10.0</attachment_rate>
                    <detachment_rate units="1/min">0.0</detachment_rate>
                    <maximum_number_of_attachments>12</maximum_number_of_attachments>
                </mechanics>
                <motility>
                    <speed units="micron/min">0.5</speed>
                    <persistence_time units="min">5</persistence_time>
                    <migration_bias units="dimensionless">0.0</migration_bias>
                    <options>
                        <enabled>true</enabled>
                        <use_2D>true</use_2D>
                        <chemotaxis>
                            <enabled>false</enabled>
                            <substrate>nutrient</substrate>
                            <direction>1</direction>
                        </chemotaxis>
                        <advanced_chemotaxis>
                            <enabled>false</enabled>
                            <normalize_each_gradient>false</normalize_each_gradient>
                            <chemotactic_sensitivities>
                                <chemotactic_sensitivity substrate="nutrient">0.0</chemotactic_sensitivity>
                                <chemotactic_sensitivity substrate="growth_factor">0.0</chemotactic_sensitivity>
                                <chemotactic_sensitivity substrate="glucose">0.0</chemotactic_sensitivity>
                                <chemotactic_sensitivity substrate="oxidative_stress_signal">0.0</chemotactic_sensitivity>
                            </chemotactic_sensitivities>
                        </advanced_chemotaxis>
                    </options>
                </motility>
                <secretion>
                    <substrate name="nutrient">
                        <secretion_rate units="1/min">0</secretion_rate>
                        <secretion_target units="substrate density">1</secretion_target>
                        <uptake_rate units="1/min">0.05</uptake_rate>
                        <net_export_rate units="total substrate/min">0</net_export_rate>
                    </substrate>
                    <substrate name="growth_factor">
                        <secretion_rate units="1/min">0</secretion_rate>
                        <secretion_target units="substrate density">1</secretion_target>
                        <uptake_rate units="1/min">0</uptake_rate>
                        <net_export_rate units="total substrate/min">0</net_export_rate>
                    </substrate>
                    <substrate name="glucose">
                        <secretion_rate units="1/min">0</secretion_rate>
                        <secretion_target units="substrate density">1</secretion_target>
                        <uptake_rate units="1/min">0.05</uptake_rate>
                        <net_export_rate units="total substrate/min">0</net_export_rate>
                    </substrate>
                    <substrate name="oxidative_stress_signal">
                        <secretion_rate units="1/min">0</secretion_rate>
                        <secretion_target units="substrate density">1</secretion_target>
                        <uptake_rate units="1/min">0</uptake_rate>
                        <net_export_rate units="total substrate/min">0</net_export_rate>
                    </substrate>
                </secretion>
                <cell_interactions>
                    <apoptotic_phagocytosis_rate units="1/min">0.0</apoptotic_phagocytosis_rate>
                    <necrotic_phagocytosis_rate units="1/min">0.0</necrotic_phagocytosis_rate>
                    <other_dead_phagocytosis_rate units="1/min">0.0</other_dead_phagocytosis_rate>
                    <live_phagocytosis_rates>
                        <phagocytosis_rate name="autophagy_cell" units="1/min">0.0</phagocytosis_rate>
                    </live_phagocytosis_rates>
                    <attack_rates>
                        <attack_rate name="autophagy_cell" units="1/min">0.0</attack_rate>
                    </attack_rates>
                    <attack_damage_rate units="1/min">1.0</attack_damage_rate>
                    <attack_duration units="min">0.1</attack_duration>
                    <fusion_rates>
                        <fusion_rate name="autophagy_cell" units="1/min">0.0</fusion_rate>
                    </fusion_rates>
                </cell_interactions>
                <cell_transformations>
                    <transformation_rates>
                        <transformation_rate name="autophagy_cell" units="1/min">0.0</transformation_rate>
                    </transformation_rates>
                </cell_transformations>
                <cell_integrity>
                    <damage_rate units="1/min">0.0</damage_rate>
                    <damage_repair_rate units="1/min">0.0</damage_repair_rate>
                </cell_integrity>
                <intracellular type="maboss">
                    <bnd_filename>./config/boolean_network/autophagy_network.bnd</bnd_filename>
                    <cfg_filename>./config/boolean_network/autophagy_network.cfg</cfg_filename>
                    <initial_values>
                        <initial_value intracellular_name="KEAP1">1</initial_value>
                        <initial_value intracellular_name="NQO1">1</initial_value>
                    </initial_values>
                    <settings>
                        <intracellular_dt>1</intracellular_dt>
                        <time_stochasticity>0.5</time_stochasticity>
                        <scaling>60</scaling>
                        <start_time>0.0</start_time>
                        <inheritance global="True" />
                    </settings>
                    <mapping>
                        <input physicell_name="nutrient" intracellular_name="AA_Starvation">
                            <settings>
                                <action>inhibition</action>
                                <threshold>0.3</threshold>
                                <smoothing>0</smoothing>
                            </settings>
                        </input>
                        <input physicell_name="growth_factor" intracellular_name="Growth_factor">
                            <settings>
                                <action>activation</action>
                                <threshold>0.5</threshold>
                                <smoothing>0</smoothing>
                            </settings>
                        </input>
                        <input physicell_name="growth_factor" intracellular_name="Insuline">
                            <settings>
                                <action>activation</action>
                                <threshold>0.5</threshold>
                                <smoothing>0</smoothing>
                            </settings>
                        </input>
                        <input physicell_name="glucose" intracellular_name="Glucose_starv">
                            <settings>
                                <action>inhibition</action>
                                <threshold>0.3</threshold>
                                <smoothing>0</smoothing>
                            </settings>
                        </input>
                        <input physicell_name="oxidative_stress_signal" intracellular_name="O_stress">
                            <settings>
                                <action>activation</action>
                                <threshold>0.5</threshold>
                                <smoothing>0</smoothing>
                            </settings>
                        </input>
                        <!-- [2026-09-21] Apoptosis to necrosis is NOT mapped through PhysiBoSS's
                             built in smoothing/steepness stochastic rate output anymore. That
                             approach (smoothing=30, steepness=4) could not distinguish a genuine
                             270 consecutive minute sustained but resolving Apoptosis transient
                             (confirmed against the MaBoSS notebook's own population trajectory)
                             from true permanent commitment once max_time was extended to 2880 min.
                             Death is now triggered deterministically in custom_modules/custom.cpp
                             (update_death_commitment) once Apoptosis has been continuously ON for
                             at least apoptosis_commit_duration minutes, see the user_parameters
                             block below. Uses Death::trigger_death(), a genuine hard minimum
                             duration gate, instead of a tuned continuous rate. See
                             DEV_LOG_2026-09-21.md for the full investigation. -->
                        <output physicell_name="cycle entry" intracellular_name="Proliferation">
                            <settings>
                                <action>activation</action>
                                <value>0.001</value>
                                <base_value>0</base_value>
                                <smoothing>0</smoothing>
                            </settings>
                        </output>
                    </mapping>
                </intracellular>
            </phenotype>
            <custom_data>
                <sample conserved="false" units="dimensionless" description="">1.0</sample>
            </custom_data>
            <initial_parameter_distributions enabled="false">
          </initial_parameter_distributions>
        </cell_definition>
    </cell_definitions>

    <cell_rules>
        <rulesets>
            <ruleset protocol="CBHG" version="3.0" format="csv" enabled="true">
                <folder>./config</folder>
                <filename>cell_rules.csv</filename>
            </ruleset>
        </rulesets>
    </cell_rules>

    <initial_conditions>
        <cell_positions enabled="true" type="csv">
            <folder>./config</folder>
            <filename>cells.csv</filename>
        </cell_positions>
    </initial_conditions>

    <user_parameters>
        <random_seed type="int" units="dimensionless" description="">0</random_seed>
        <node_to_visualize type="string" units="" description="">Apoptosis</node_to_visualize>
        <apoptosis_commit_duration type="double" units="min" description="minimum number of consecutive minutes the MaBoSS Apoptosis node must stay ON before the cell is deterministically committed to necrosis via Death::trigger_death() in custom.cpp. Empirically tuned (see DEV_LOG_2026-09-21.md): 600 min still let 19-20% of cells in scenarios that should be almost fully protective (growth factor stimulation, rapamycin+growth factor) eventually cross the threshold by chance over the full 2880 min run, and left the intermediate BECN1-ON conditions 10-20 points more lethal than the MaBoSS notebook predicts, because a fixed hard duration threshold is a one-way ratchet -- the cumulative fraction of cells that ever cross it keeps climbing the longer the run continues, especially for conditions where the Apoptosis node keeps fluctuating throughout the whole run rather than settling early. 900 min brought every condition back in line with the notebook (protective conditions down to the same ~3-4% residual noise already documented elsewhere in this project; intermediate BECN1-ON conditions within a few percentage points of their notebook figures) without needing a fundamentally different mechanism.">900</apoptosis_commit_duration>
    </user_parameters>
</PhysiCell_settings>